{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "sheet_title": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "scope": {
            "type": "object",
            "properties": {
              "work_type": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "action": {
                "enum": [
                  null,
                  "install",
                  "remove",
                  "replace",
                  "relocate",
                  "rehabilitate",
                  "protect",
                  "modify",
                  "reconnect",
                  "connect",
                  "abandon",
                  "remain"
                ]
              },
              "material": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "specification": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "method": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "work_type",
              "action",
              "material",
              "specification",
              "method"
            ],
            "additionalProperties": false
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "asset_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ]
          },
          "identity_context": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ]
          },
          "representation": {
            "enum": [
              "installation",
              "schedule",
              "overview",
              "typical_detail",
              "unknown"
            ]
          },
          "measurement": {
            "type": "object",
            "properties": {
              "operation": {
                "enum": [
                  "printed",
                  "count",
                  "sum",
                  "product",
                  "difference",
                  "unresolved"
                ]
              },
              "operands": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "number",
                      "minimum": 0
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "value",
                    "unit",
                    "quote"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 200
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "operation",
              "operands",
              "explanation"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "location": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "bbox": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "quote",
                "location",
                "bbox"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 200
          },
          "quality": {
            "enum": [
              "clear",
              "ambiguous",
              "unreadable"
            ]
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        },
        "required": [
          "description",
          "scope",
          "unit",
          "asset_id",
          "identity_context",
          "representation",
          "measurement",
          "evidence",
          "quality",
          "uncertainties"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "review_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "bbox": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minItems": 4,
                "maxItems": 4
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "reason",
          "bbox"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "enum": [
        "complete",
        "partial",
        "unreadable"
      ]
    }
  },
  "required": [
    "page",
    "sheet_title",
    "items",
    "review_regions",
    "coverage"
  ],
  "additionalProperties": false
}
